{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 -m http.server:*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)",
      "Bash(curl -sI http://localhost:*)",
      "Bash(node --check:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree list)",
      "Bash(git branch -vv:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)"
    ]
  }
}
